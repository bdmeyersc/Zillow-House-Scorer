{
  "manifest_version": 3,
  "name": "House Scorer for Zillow",
  "version": "1.8.0",
  "description": "Scores Zillow listings against Bruce's downsizing checklist.",
  "permissions": ["storage", "unlimitedStorage", "identity", "alarms"],
  "host_permissions": ["https://geocoding.geo.census.gov/*", "https://nominatim.openstreetmap.org/*", "https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"],
  "oauth2": {
    "client_id": "PASTE_YOUR_CLIENT_ID_HERE.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open House Scorer report" },
  "options_page": "filters.html",
  "content_scripts": [
    {
      "matches": ["https://www.zillow.com/*"],
      "js": ["scorer.js", "filters-store.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
